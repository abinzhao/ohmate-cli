{
  "name": "@ohmate/cli-common",
  "version": "0.1.0",
  "description": "OHMate shared runtime and bundled HarmonyOS development tools",
  "supportedDocsApi": 1,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/runtime.js",
    "./dist/cli.js": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "src/resources",
    "THIRD-PARTY-LICENSES",
    "upstream-baseline.json",
    "docs",
    "skills"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/sync-cli-docs.mjs",
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "prepack": "node ../../scripts/sync-cli-docs.mjs",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "harmonyos",
    "deveco",
    "cli"
  ],
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ohmate/knowledgebase": "0.1.0",
    "@xmldom/xmldom": "^0.8.15",
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "colorette": "^2.0.20",
    "commander": "^13.1.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "global-agent": "^4.1.3",
    "json5": "^2.2.3",
    "mp4box": "^2.4.1",
    "node-forge": "^1.4.0",
    "ora": "^9.4.0",
    "p-limit": "^5.0.0",
    "proper-lockfile": "^4.1.2",
    "regedit": "^5.1.4",
    "semver": "^7.8.5",
    "smol-toml": "^1.6.1",
    "socket.io-client": "^4.7.5",
    "ui-verification-mcp": "0.0.18",
    "ws": "8.21.1",
    "xpath": "^0.0.35",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/global-agent": "^3.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.7.1",
    "@types/ws": "8.18.2"
  }
}
